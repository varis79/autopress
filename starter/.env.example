# Autopress · variables de entorno
# ---------------------------------
# Copia este fichero a `.env` y rellena los valores. NUNCA subas `.env` al repo
# (ya está en .gitignore). En producción, estos valores van en los "secrets" de
# GitHub Actions y en las variables de entorno del host, no en el repo.

# --- IA (obligatoria para redactar la edición de verdad) ---
# Sin esta clave, el pipeline funciona igual pero en modo STUB (no gasta y marca
# la edición como borrador que no debe publicarse). Consíguela en tu proveedor.
ANTHROPIC_API_KEY=

# --- Newsletter (Resend) · estas van en el HOST (Cloudflare Pages), no solo aquí ---
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Clave para firmar los enlaces de confirmación y baja (HMAC). Genera una aleatoria
# larga (p. ej. `openssl rand -hex 32`). Si la cambias, invalidas los enlaces enviados.
NEWSLETTER_SECRET=
# Remitente del boletín (dominio verificado en Resend) y URL pública del sitio.
NEWSLETTER_FROM=Boletín <hola@tudominio.com>
SITE_URL=https://tudominio.com

# --- Anti-bot del formulario (Cloudflare Turnstile) · opcional ---
TURNSTILE_SECRET_KEY=

# --- Deploy · opcional ---
DEPLOY_HOOK=
